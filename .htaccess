# 設定ファイルとスクリプトを外部から見えないようにする
<FilesMatch "^\.env|\.py$|^base\.csv$|^NUMBERS3_ALL\.csv$">
  Require all denied
</FilesMatch>
# 運用メモはサーバーには上がるが外部には見せない
<FilesMatch "^(運用メモ|はじめに)\.md$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
